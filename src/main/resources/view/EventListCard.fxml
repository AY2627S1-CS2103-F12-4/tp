<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox id="cardPane" spacing="4" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="10" right="10" bottom="10" left="15" />
  </padding>
  <HBox alignment="CENTER_LEFT">
    <Label fx:id="index" styleClass="cell_big_label" minWidth="-Infinity" />
    <Label fx:id="name" styleClass="cell_big_label" wrapText="true" />
  </HBox>
  <Label fx:id="eventId" styleClass="cell_small_label" />
  <Label fx:id="capacity" styleClass="cell_small_label" />
  <Label fx:id="description" styleClass="cell_small_label" wrapText="true" />
</VBox>
