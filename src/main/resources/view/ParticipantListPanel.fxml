<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="6" styleClass="background" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding><Insets top="5" right="5" bottom="5" left="5" /></padding>
  <Label fx:id="eventHeading" text="Participant search" styleClass="label-bright" wrapText="true" />
  <Label fx:id="searchHeading"
         text="Use search-participant NAME [/event EVENTID] or search-role ROLE [/event EVENTID]"
         styleClass="label-bright" wrapText="true" />
  <ListView fx:id="participantListView" VBox.vgrow="ALWAYS" />
</VBox>
