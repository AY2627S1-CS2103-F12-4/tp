<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane"
      fx:id="cardPane"
      alignment="CENTER_LEFT"
      spacing="8"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">

  <padding>
    <Insets top="10" right="16" bottom="10" left="15" />
  </padding>

  <VBox alignment="CENTER_LEFT"
        spacing="4"
        HBox.hgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="0.5">
      <Label fx:id="id"
             styleClass="cell_big_label" />

      <Label fx:id="name"
             styleClass="cell_big_label"
             wrapText="true" />
    </HBox>

    <FlowPane fx:id="tags"
              hgap="7"
              vgap="3" />

    <Label fx:id="personId"
           styleClass="cell_small_label" />

    <Label fx:id="phone"
           styleClass="cell_small_label" />

    <Label fx:id="address"
           styleClass="cell_small_label"
           wrapText="true" />

    <Label fx:id="email"
           styleClass="cell_small_label" />
  </VBox>

  <Button fx:id="editButton"
          mnemonicParsing="false"
          styleClass="button, card-action-button"
          text="Edit" />

  <Button fx:id="deleteButton"
          mnemonicParsing="false"
          styleClass="button, card-delete-button"
          text="Delete" />
</HBox>
